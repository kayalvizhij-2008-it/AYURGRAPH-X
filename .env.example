# ==========================================
# AYURGRAPH-X Full-Stack Environment Variables
# ==========================================

# Frontend (Vercel)
NEXT_PUBLIC_API_URL=https://ayurgraph-x-api.onrender.com

# Backend (Render)
APP_ENV=production
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["*"]

# Optional External API Keys (Fallbacks to open public endpoints)
PUBCHEM_API_BASE=https://pubchem.ncbi.nlm.nih.gov/rest/pug
CHEMBL_API_BASE=https://www.ebi.ac.uk/chembl/api/data
GBIF_API_BASE=https://api.gbif.org/v1
PUBMED_API_BASE=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
NCBI_API_KEY=
REQUEST_TIMEOUT_SECONDS=10
